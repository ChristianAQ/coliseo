rules_version = '2';

// Reglas de referencia para la base de datos de Firestore del proyecto
// (Firebase Console → Firestore Database → Reglas → pega esto → Publicar).
//
// La app todavía no tiene autenticación de usuarios, así que de momento se
// permite lectura/escritura pública en la colección "tournaments" para que
// el prototipo funcione. Cuando se añada login, hay que restringir esto por
// usuario (p.ej. comprobando un campo "ownerId" == request.auth.uid).
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }
  }
}
